@startuml
' StreetFoodNarrator - Functional Class Diagram (Simplified)
top to bottom direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #6B4FA2
skinparam package {
  BackgroundColor #FBF8FF
  BorderColor #8A6BC1
}
skinparam class {
  BackgroundColor #F2EBFA
  BorderColor #6B4FA2
}
skinparam interface {
  BackgroundColor #EFE6FA
  BorderColor #6B4FA2
}

package "(Mobile App MVVM)" as L1 {
  class MainViewModel {
    +LoadNearbyPOIs()
    +StartLocationTracking()
    +RefreshNotifications()
    +OpenPOIDetail(poiId)
    +StartTour(tourId)
  }

  class POIDetailViewModel {
    +LoadPOIDetail(poiId)
    +LoadReviews(poiId)
    +SubmitReview()
    +PlayNarration(language)
    +ToggleFavorite()
  }

  class VirtualTourViewModel {
    +LoadTour(tourId)
    +StartTour()
    +NextStop()
    +PreviousStop()
    +CompleteTour()
  }

  class VendorDashboardViewModel {
    +LoadMyVendorProfile()
    +UpdateVendorProfile()
    +CreatePOI()
    +TrackSubmissionStatus()
  }

  interface IGeofenceService {
    +StartMonitoring()
    +StopMonitoring()
    +HandleZoneTrigger()
  }

  interface IReviewService {
    +GetReviews(poiId)
    +CreateReview(poiId, rating, comment)
    +DeleteReview(reviewId)
  }

  interface ITTSService {
    +GenerateNarration(text, language)
    +PlayAudio(audioUrl)
    +StopAudio()
  }

  interface INotificationService {
    +GetSidebarNotifications()
    +MarkAsRead(notificationId)
    +GetUnreadCount()
  }
}

package "(API - Controllers)" as L2 {
  class AuthController {
    +Login()
    +Register()
    +RefreshToken()
    +GetMe()
  }

  class UsersController {
    +GetProfile()
    +UpdateProfile()
  }

  class VendorsController {
    +GetMyVendor()
    +UpdateMyVendor()
    +SubmitVerification()
    +GetVendorDashboard()
  }

  class POIsController {
    +GetNearby()
    +GetById(poiId)
    +CreatePOI()
    +UpdatePOI(poiId)
    +ApprovePOI(poiId)
    +RejectPOI(poiId)
  }

  class MenuItemsController {
    +GetByPOI(poiId)
    +CreateMenuItem()
    +UpdateMenuItem(menuItemId)
    +DeleteMenuItem(menuItemId)
  }

  class ReviewsController {
    +GetByPOI(poiId)
    +CreateReview()
    +UpdateReview(reviewId)
    +DeleteReview(reviewId)
  }

  class ToursController {
    +GetTours()
    +GetTourDetail(tourId)
    +CreateTour()
    +UpdateTour(tourId)
  }

  class AudioController {
    +UploadAudio()
    +GetByPOI(poiId)
    +DeleteAudio(audioId)
  }

  class TTSController {
    +GenerateTTS()
    +GenerateAndSaveAudio()
    +GetTTSByPOI(poiId)
  }

  class NotificationsController {
    +GetSidebar(limit)
    +MarkRead(notificationId)
    +MarkAllRead()
    +GetUnreadCount()
  }

  class PaymentsController {
    +CreateCheckoutSession()
    +ConfirmPayment()
    +HandleWebhook()
  }

  class SubscriptionsController {
    +GetCurrentSubscription()
    +UpgradePlan()
    +CancelPlan()
  }

  class AnalyticsController {
    +TrackNarrationEvent()
    +GetOverview()
    +GetTopPOIs()
    +GetUsageByLanguage()
  }
}

package "(Application Services)" as L3 {
  class GeofenceService {
    +EvaluateZoneEntry()
    +EvaluateZoneExit()
    +ApplyCooldownRule()
  }

  class NotificationService {
    +BuildAudience()
    +CreateNotification()
    +GetSidebarPayload()
  }

  class TourService {
    +BuildTourRoute()
    +ComputeNextStop()
  }
}

' Enforce vertical layer ordering
L1 -[hidden]down-> L2
L2 -[hidden]down-> L3

' Mobile dependencies
MainViewModel ..> IGeofenceService
MainViewModel ..> INotificationService
MainViewModel ..> POIsController : REST
MainViewModel ..> NotificationsController : REST

POIDetailViewModel ..> POIsController : REST
POIDetailViewModel ..> ReviewsController : REST
POIDetailViewModel ..> ITTSService

VirtualTourViewModel ..> ToursController : REST
VendorDashboardViewModel ..> VendorsController : REST
VendorDashboardViewModel ..> POIsController : REST

' Service contracts to API
IReviewService ..> ReviewsController
ITTSService ..> TTSController
INotificationService ..> NotificationsController

' API to application services
POIsController ..> GeofenceService
NotificationsController ..> NotificationService
ToursController ..> TourService

note bottom
  Lược bỏ toàn bộ liên kết tới Domain Models
  để sơ đồ tập trung vào chức năng chính và dễ đọc.
end note

@enduml
