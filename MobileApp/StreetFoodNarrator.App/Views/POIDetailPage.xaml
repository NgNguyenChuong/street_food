<?xml version="1.0" encoding="utf-8" ?>
<!--
    POIDetailPage.xaml – Trang chi tiết quán ăn
    Thiết kế theo mẫu với màu xanh lá chủ đạo
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:models="clr-namespace:StreetFoodNarrator.App.Core.Models"
             xmlns:views="clr-namespace:StreetFoodNarrator.App.Views"
             x:Class="StreetFoodNarrator.App.Views.POIDetailPage"
             BackgroundColor="#0A1612"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

            <!-- Header: Full-bleed restaurant image -->
            <Grid HeightRequest="320">
                <!-- Base: green fallback background -->
                <BoxView BackgroundColor="#22C55E"/>
                
                <!-- Hero image: fills entire header area -->
                <Image Source="{Binding DisplayImageUrl}"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill"/>
                
                <!-- Dark gradient overlay so buttons are readable -->
                <BoxView VerticalOptions="Start" HeightRequest="100">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#99000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                
                <!-- Top bar with back and share buttons -->
                <Grid Margin="16,48,16,0" HeightRequest="40"
                      HorizontalOptions="Fill" VerticalOptions="Start">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Back button -->
                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                            StrokeShape="RoundRectangle 20" BackgroundColor="#00000060"
                            HorizontalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#xF004D;" FontFamily="MDI" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    
                    <!-- Share button -->
                    <Border Grid.Column="1" WidthRequest="40" HeightRequest="40"
                            StrokeShape="RoundRectangle 20" BackgroundColor="#00000060"
                            HorizontalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShareTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#xF0FC8;" FontFamily="MDI" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Content on dark background -->
            <Border StrokeShape="RoundRectangle 32,32,0,0" BackgroundColor="#1A1A1A" 
                    Margin="0,-30,0,0" Padding="0">
                <VerticalStackLayout Spacing="0">
                    
                    <!-- Header section with name, status and rating -->
                    <VerticalStackLayout Padding="24,24,24,16" Spacing="12">
                        <Label Text="{Binding Name_Vi, TargetNullValue='Ốc Oanh'}" 
                               FontSize="28" FontAttributes="Bold"
                               TextColor="White" LineBreakMode="WordWrap"/>
                        
                        <HorizontalStackLayout Spacing="10">
                            <!-- Open status badge -->
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#22C55E" 
                                    Padding="10,6">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="●" FontSize="10" TextColor="White" 
                                           VerticalOptions="Center"/>
                                    <Label Text="ĐANG MỞ CỬA" FontSize="11" FontAttributes="Bold" 
                                           TextColor="White"/>
                                </HorizontalStackLayout>
                            </Border>
                            
                            <!-- Rating badge -->
                            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#2A2A2A" 
                                    Padding="10,6">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="⭐" FontSize="12" VerticalOptions="Center"/>
                                    <Label FontSize="13" FontAttributes="Bold" TextColor="White"
                                           VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Rating, StringFormat='{0:F1}', TargetNullValue='4.5'}"/>
                                                <Span Text="(1,200+ đánh giá)" TextColor="#999999"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Info section -->
                    <VerticalStackLayout Padding="24,0,24,20" Spacing="16">
                        <!-- Address -->
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="40" HeightRequest="40" 
                                    StrokeShape="RoundRectangle 20" BackgroundColor="#FF6B3520"
                                    VerticalOptions="Start">
                                <Label Text="&#xF034E;" FontFamily="MDI" FontSize="20" 
                                       TextColor="#FF6B35"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="4" FlexLayout.Grow="1">
                                <Label Text="ĐỊA CHỈ" FontSize="11" FontAttributes="Bold" 
                                       TextColor="#999999"/>
                                <Label Text="{Binding Address, TargetNullValue='534 Vĩnh Khánh, Phường 10, Quận 4, TP. Hồ Chí Minh'}"
                                       FontSize="14" TextColor="White" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Opening hours -->
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="40" HeightRequest="40" 
                                    StrokeShape="RoundRectangle 20" BackgroundColor="#FF6B3520"
                                    VerticalOptions="Start">
                                <Label Text="&#xF0954;" FontFamily="MDI" FontSize="20" 
                                       TextColor="#FF6B35"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="4" FlexLayout.Grow="1">
                                <Label Text="GIỜ MỞ CỬA" FontSize="11" FontAttributes="Bold" 
                                       TextColor="#999999"/>
                                <Label Text="{Binding OpeningHoursText, FallbackValue='16:00 - 23:00 mỗi ngày'}"
                                       FontSize="14" TextColor="White" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Phone -->
                        <HorizontalStackLayout Spacing="12">
                            <Border WidthRequest="40" HeightRequest="40" 
                                    StrokeShape="RoundRectangle 20" BackgroundColor="#FF6B3520"
                                    VerticalOptions="Start">
                                <Label Text="&#xF0B0;" FontFamily="MDI" FontSize="20" 
                                       TextColor="#FF6B35"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Spacing="4" FlexLayout.Grow="1">
                                <Label Text="ĐIỆN THOẠI" FontSize="11" FontAttributes="Bold" 
                                       TextColor="#999999"/>
                                <Label Text="{Binding PhoneNumber, FallbackValue='090 123 4567'}"
                                       FontSize="14" TextColor="White">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPhoneTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Signature dishes section -->
                    <VerticalStackLayout Padding="24,8,24,20" Spacing="14">
                        <Label Text="Món đặc trưng" FontSize="18" FontAttributes="Bold"
                               TextColor="White"/>

                        <!-- Horizontal carousel with prev/next arrows -->
                        <Grid>
                            <CarouselView x:Name="DishCarousel"
                                          HeightRequest="160" Loop="False"
                                          ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type views:POIDetailPage}}, Path=MenuItems}">
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MenuItemDto">
                                        <Border StrokeShape="RoundRectangle 16" BackgroundColor="#2A2A2A"
                                                Padding="14" Margin="4,0">
                                            <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                                <Border StrokeShape="RoundRectangle 12"
                                                        WidthRequest="72" HeightRequest="72"
                                                        BackgroundColor="#1A3426"
                                                        HorizontalOptions="Center">
                                                    <Image Source="{Binding DisplayImageUrl}" Aspect="AspectFill"
                                                           WidthRequest="72" HeightRequest="72"/>
                                                </Border>
                                                <Label Text="{Binding Name_Vi}" FontSize="14" FontAttributes="Bold"
                                                       TextColor="White" HorizontalTextAlignment="Center"
                                                       LineBreakMode="WordWrap" MaxLines="2"/>
                                                <Label Text="{Binding Price, StringFormat='{0:N0} đ'}"
                                                       FontSize="13" TextColor="#FF6B35"
                                                       HorizontalTextAlignment="Center"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>

                            <!-- Left arrow -->
                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#66000000" Stroke="Transparent"
                                    HorizontalOptions="Start" VerticalOptions="Center" Margin="4,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDishPrev"/>
                                </Border.GestureRecognizers>
                                <Label Text="&#xF004D;" FontFamily="MDI" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>

                            <!-- Right arrow -->
                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                    BackgroundColor="#66000000" Stroke="Transparent"
                                    HorizontalOptions="End" VerticalOptions="Center" Margin="4,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDishNext"/>
                                </Border.GestureRecognizers>
                                <Label Text="&#xF0054;" FontFamily="MDI" FontSize="20" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <!-- Position indicator: 1 / 3 -->
                        <Label x:Name="DishIndicatorLabel" Text="" FontSize="11"
                               TextColor="#6B7280" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Location/Map section -->
                    <VerticalStackLayout Padding="24,8,24,24" Spacing="12">
                        <Label Text="Vị trí" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                        
                        <Border StrokeShape="RoundRectangle 12" 
                                BackgroundColor="#1A1A1A"
                                Stroke="#2A2A2A"
                                StrokeThickness="1"
                                HeightRequest="240"
                                Padding="0">
                            <mapsui:MapControl x:Name="MapView"
                                              HorizontalOptions="Fill"
                                              VerticalOptions="Fill"
                                              BackgroundColor="#1A1A1A"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Bottom spacing for button -->
                    <BoxView HeightRequest="100" BackgroundColor="Transparent"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom action button -->
        <Border VerticalOptions="End"
                Margin="20,0,20,32"
                StrokeShape="RoundRectangle 16" 
                BackgroundColor="#3B82F6"
                Padding="0,18">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNavigateTapped"/>
            </Border.GestureRecognizers>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <Label Text="&#xF03B0;" FontFamily="MDI" FontSize="20" TextColor="White"
                       VerticalOptions="Center"/>
                <Label Text="Chỉ đường ngay" FontSize="16" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
    </Grid>

</ContentPage>
