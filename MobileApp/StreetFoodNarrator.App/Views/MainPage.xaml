<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StreetFoodNarrator.App.ViewModels"
             xmlns:models="clr-namespace:StreetFoodNarrator.App.Core.Models"
             xmlns:converters="clr-namespace:StreetFoodNarrator.App.Converters"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="StreetFoodNarrator.App.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:ZoneTypeToColorConverter x:Key="ZoneTypeColor" />
        <converters:BoolToTrackingLabelConverter x:Key="TrackingLabel" />
        <converters:InvertedBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <!-- Main Grid: Map base + Overlay UI -->
    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <!-- Map -->
        <maps:Map x:Name="MapView"
                  Grid.Row="0" Grid.Column="0"
                  IsShowingUser="True"
                  MapType="Street"
                  VerticalOptions="Fill"
                  HorizontalOptions="Fill" />

        <!-- LAYER 2: FLOATING UI OVERLAY -->
        <Grid Grid.Row="0" Grid.Column="0"
              RowDefinitions="Auto,*,Auto"
              Padding="0"
              InputTransparent="False">

            <!-- TOP BAR: Status + GPS Button -->
            <Border Grid.Row="0"
                    BackgroundColor="White"
                    Padding="16,48,16,16"
                    Shadow="{Shadow Brush=Black, Opacity=0.08, Radius=8, Offset='0,2'}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <!-- App Title -->
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Street Food Narrator"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="#1A1A1A" />
                        <Label Text="{Binding CoordDisplay}"
                               FontSize="11" TextColor="#6B7280"
                               IsVisible="{Binding IsSimulated}" />
                    </VerticalStackLayout>

                    <!-- Zone Counter Badge -->
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#22C55E"
                            Padding="12,6"
                            IsVisible="{Binding IsInsideAnyZone}">
                        <Label Text="{Binding ActiveZoneCount, StringFormat='Trong {0} v�ng'}"
                               TextColor="White" FontSize="13" FontAttributes="Bold" />
                    </Border>

                    <!-- GPS Status Icon -->
                    <Border Grid.Column="2"
                            StrokeShape="RoundRectangle 24"
                            BackgroundColor="{Binding IsTracking, Converter={StaticResource ZoneTypeColor}}"
                            WidthRequest="48" HeightRequest="48"
                            Shadow="{Shadow Brush=Black, Opacity=0.12, Radius=8, Offset='0,2'}">
                        <Label Text="{Binding IsTracking, Converter={StaticResource TrackingLabel}}"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               TextColor="White" FontSize="18" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleTrackingCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>

            <!-- MIDDLE: FLOATING PRIMARY ZONE CARD (when active) -->
            <Border Grid.Row="1"
                    VerticalOptions="End"
                    Margin="16,0,16,20"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="0"
                    IsVisible="{Binding IsInsideAnyZone}"
                    Shadow="{Shadow Brush=Black, Opacity=0.15, Radius=20, Offset='0,8'}">

                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
                    <!-- Header: Zone Type Badge -->
                    <Border Grid.Row="0"
                            StrokeShape="RoundRectangle 0"
                            BackgroundColor="{Binding PrimaryZoneType, Converter={StaticResource ZoneTypeColor}}"
                            Padding="20,12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="{Binding PrimaryZoneName}"
                                   TextColor="White" FontSize="18" FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label Grid.Column="1"
                                   Text="{Binding PrimaryZoneEmoji}"
                                   FontSize="24" />
                        </Grid>
                    </Border>

                    <!-- Body: Description + Audio Controls -->
                    <VerticalStackLayout Grid.Row="1" Spacing="16" Padding="20">
                        <Label Text="{Binding PrimaryZoneDesc}"
                               TextColor="#374151" FontSize="15"
                               LineBreakMode="WordWrap" MaxLines="3" />

                        <!-- Audio Player UI -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16"
                              IsVisible="{Binding IsAudioPlaying}">
                            <!-- Play/Pause Button -->
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 28"
                                    BackgroundColor="#22C55E"
                                    WidthRequest="56" HeightRequest="56"
                                    Shadow="{Shadow Brush=#22C55E, Opacity=0.3, Radius=8, Offset='0,4'}">
                                <Label Text="▶️" FontSize="24"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleAudioCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Progress Bar -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                <ProgressBar Progress="{Binding AudioProgress}"
                                             ProgressColor="#22C55E"
                                             HeightRequest="4" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding AudioTimeElapsed}"
                                           FontSize="12" TextColor="#6B7280" />
                                    <Label Grid.Column="1"
                                           Text="{Binding AudioDuration}"
                                           FontSize="12" TextColor="#6B7280" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Volume Icon -->
                            <Label Grid.Column="2"
                                   Text="🔊" FontSize="24"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Footer: Quick Actions -->
                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="1"
                          Padding="0"
                          BackgroundColor="#F3F4F6">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 0"
                                BackgroundColor="White"
                                Padding="16,14">
                            <Label Text="📍 Xem trên bản đồ"
                                   TextColor="#3B82F6" FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CenterMapCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 0"
                                BackgroundColor="White"
                                Padding="16,14">
                            <Label Text="📝 Chi tiết"
                                   TextColor="#6B7280" FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowDetailsCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- BOTTOM: CONTROL PANEL -->
            <Border Grid.Row="2"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Padding="20,16,20,32"
                    Shadow="{Shadow Brush=Black, Opacity=0.1, Radius=20, Offset='0,-4'}">

                <VerticalStackLayout Spacing="16">
                    <!-- Expand/Collapse Handle -->
                    <BoxView HeightRequest="4" WidthRequest="40"
                             BackgroundColor="#D1D5DB"
                             CornerRadius="2"
                             HorizontalOptions="Center" />

                    <!-- Current Status Message -->
                    <Border StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F3F4F6"
                            Padding="16,12"
                            IsVisible="{Binding IsInsideAnyZone, Converter={StaticResource InverseBool}}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="⚙️"
                                   FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Đang khám phá..."
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="Di chuyển đến địa điểm để nghe giới thiệu"
                                       FontSize="13" TextColor="#6B7280" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Simulator Controls (Dev Mode) -->
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          IsVisible="{Binding IsSimulated}">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="#ECFDF5"
                                Padding="12,10">
                            <Label Text="{Binding SimStepLabel}"
                                   TextColor="#059669" FontSize="13"
                                   VerticalOptions="Center" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="⏭️"
                                Command="{Binding StepSimulatorCommand}"
                                BackgroundColor="#10B981"
                                TextColor="White"
                                FontSize="20"
                                CornerRadius="12"
                                WidthRequest="60" HeightRequest="44" />
                    </Grid>

                    <!-- Main Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <!-- Start/Stop Tour Button -->
                        <Button Grid.Column="0"
                                Text="{Binding IsTracking, Converter={StaticResource TrackingLabel}}"
                                Command="{Binding ToggleTrackingCommand}"
                                BackgroundColor="#22C55E"
                                TextColor="White"
                                FontSize="16" FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="56"
                                Shadow="{Shadow Brush=#22C55E, Opacity=0.3, Radius=8, Offset='0,4'}" />

                        <!-- Settings/Menu Button -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#E5E7EB"
                                BackgroundColor="White"
                                WidthRequest="56" HeightRequest="56">
                            <Label Text="⚙️" FontSize="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowSettingsCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- LAYER 3: SETTINGS/DEBUG DRAWER (Slide from right) -->
        <Border Grid.Row="0" Grid.Column="0"
                x:Name="SettingsDrawer"
                HorizontalOptions="End"
                WidthRequest="320"
                BackgroundColor="White"
                Shadow="{Shadow Brush=Black, Opacity=0.2, Radius=24, Offset='-4,0'}"
                IsVisible="{Binding IsSettingsOpen}"
                TranslationX="320">
            
            <ScrollView Padding="20,60,20,20">
                <VerticalStackLayout Spacing="20">
                    <!-- Close Button -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="❌ Đóng Đặt"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="#1F2937" />
                        <Label Grid.Column="1"
                               Text="?" FontSize="28" TextColor="#9CA3AF">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseSettingsCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" />

                    <!-- Session Stats -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📊 Thống Kê Phiên" 
                               FontSize="15" FontAttributes="Bold"
                               TextColor="#374151" />
                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F9FAFB"
                                Padding="12">
                            <Label Text="{Binding SessionSummary}"
                                   FontSize="13" TextColor="#6B7280" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Active Zones List -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📍 Các Vùng đang Trong"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="#374151" />
                        <CollectionView ItemsSource="{Binding ActiveZones}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 8"
                                            BackgroundColor="#F3F4F6"
                                            Padding="12,10"
                                            Margin="0,4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0">
                                                <Label Text="{Binding Name_Vi}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="#1F2937" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding ZoneType}"
                                                   FontSize="11"
                                                   TextColor="#9CA3AF"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Log -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📝 Nhật Ký"
                               FontSize="15" FontAttributes="Bold"
                               TextColor="#374151" />
                        <Border StrokeShape="RoundRectangle 8"
                                BackgroundColor="#F9FAFB"
                                Padding="12"
                                HeightRequest="200">
                            <ScrollView>
                                <CollectionView ItemsSource="{Binding StatusLog}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding .}"
                                                   FontSize="11"
                                                   TextColor="#6B7280"
                                                   FontFamily="Monospace"
                                                   Padding="0,2" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </ScrollView>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Reset Button -->
                    <Button Text="🔄 Reset Phiên"
                            Command="{Binding ResetSessionCommand}"
                            BackgroundColor="#EF4444"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>
