<?xml version="1.0" encoding="utf-8" ?>
<!--
    TabMenuView.xaml - Tab Danh sách tour
    Search + pull-to-refresh + danh sách tour đồng bộ backend
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StreetFoodNarrator.App.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="StreetFoodNarrator.App.Views.Components.TabMenuView"
             x:Name="Root"
             BackgroundColor="#0A1612">

    <Grid RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" BackgroundColor="#0A1612" Padding="14,52,14,8">
            <SearchBar Placeholder="Tìm kiếm tour..."
                       Text="{Binding TourSearchQuery}"
                       BackgroundColor="#0E1E17" TextColor="White"
                       PlaceholderColor="#6B7280"/>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,8"
                IsVisible="{Binding IsTourDataStale}"
                BackgroundColor="#D97706" Padding="12,8" StrokeThickness="0">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="&#xF1AF0;" FontFamily="MDI" TextColor="White" FontSize="18" VerticalOptions="Center"/>
                <Label Text="Đang dùng dữ liệu tour đã lưu. Kéo xuống để thử cập nhật."
                       TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsToursLoading}"
                     Command="{Binding RefreshToursCommand}">
            <CollectionView ItemsSource="{Binding FilteredTours}" Margin="0,0,0,72">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,60,0,0">
                        <Label Text="&#xF0349;" FontFamily="MDI" FontSize="42"
                               TextColor="#4B5563" HorizontalOptions="Center"/>
                        <Label Text="Chưa có tour phù hợp" FontSize="15"
                               TextColor="#6B7280" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="14,0,14,10" StrokeShape="RoundRectangle 16"
                                BackgroundColor="#0E1E17" Stroke="#1C3024" Padding="12">
                            <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="#1A3426" WidthRequest="64" HeightRequest="64">
                                    <Image Source="{Binding CoverImageUrl}" Aspect="AspectFill"
                                           WidthRequest="64" HeightRequest="64" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="14"
                                           FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="{Binding Description}" FontSize="12"
                                           TextColor="#9CA3AF" LineBreakMode="TailTruncation" MaxLines="2"/>
                                    <Label Text="{Binding PoiCount, StringFormat='🧭 {0} điểm dừng'}"
                                           FontSize="11" TextColor="#22C55E"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="2" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="#22C55E18"
                                        Stroke="#22C55E30" WidthRequest="72" HeightRequest="36">
                                    <Label Text="{Binding EstimatedDurationMinutes, StringFormat='~{0}p'}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="#22C55E" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentView>
