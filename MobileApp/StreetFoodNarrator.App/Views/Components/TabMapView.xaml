<?xml version="1.0" encoding="utf-8" ?>
<!--
    TabMapView.xaml  –  Tab 0: Bản đồ
    Chứa: MapTopBar (gradient header) + MapLegend + MapRightControls (zoom)
    Layout: AbsoluteLayout nội bộ (full-screen ContentView)
    Sự kiện: BackRequested, CenterMapRequested, SettingsRequested, ZoomInRequested, ZoomOutRequested
-->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StreetFoodNarrator.App.Views.Components.TabMapView">

    <AbsoluteLayout>

        <!-- ── Top gradient bar + tiêu đề tour ── -->
        <Grid x:Name="MapTopBarGrid"
              AbsoluteLayout.LayoutBounds="0,0,1,-1"
              AbsoluteLayout.LayoutFlags="WidthProportional"
              Padding="14,48,14,12">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#CC000000" Offset="0.0"/>
                    <GradientStop Color="#55000000" Offset="0.7"/>
                    <GradientStop Color="#00000000" Offset="1.0"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid ColumnDefinitions="48,*,48" ColumnSpacing="8">

                <!-- Nút Back -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 14" BackgroundColor="#0E1E17"
                        Stroke="#1C3024" StrokeThickness="1"
                        WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                    <Border.Shadow><Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2"/></Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xF004D;" FontFamily="MDI" FontSize="22" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Title chip (contains network status sub-line) -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 14" BackgroundColor="#0E1E17"
                        Stroke="#1C3024" StrokeThickness="1"
                        Padding="14,9" VerticalOptions="Center">
                    <Border.Shadow><Shadow Brush="#22C55E" Opacity="0.12" Radius="8" Offset="0,2"/></Border.Shadow>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsOffline}" Value="True">
                            <Setter Property="Stroke" Value="#F9731655"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center">

                        <!-- Tour name row -->
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <BoxView WidthRequest="8" HeightRequest="8"
                                     BackgroundColor="#22C55E" CornerRadius="4" VerticalOptions="Center"/>
                            <Label Text="🍜 Phố ẩm thực Vĩnh Khánh"
                                   FontSize="13" FontAttributes="Bold" TextColor="White"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                        </HorizontalStackLayout>

                        <!-- Network status: Online -->
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center"
                                               IsVisible="{Binding IsOffline, Converter={StaticResource InvertedBoolConverter}}">
                            <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="2.5"
                                     BackgroundColor="#22C55E" VerticalOptions="Center"/>
                            <Label Text="Online" FontSize="10" TextColor="#86EFAC" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Network status: Offline -->
                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center"
                                               IsVisible="{Binding IsOffline}">
                            <BoxView WidthRequest="5" HeightRequest="5" CornerRadius="2.5"
                                     BackgroundColor="#F97316" VerticalOptions="Center"/>
                            <Label Text="Ngoại tuyến" FontSize="10" TextColor="#FCA36E" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Spacer cân bằng -->
                <BoxView Grid.Column="2" WidthRequest="48" BackgroundColor="Transparent"/>

            </Grid>
        </Grid>

        <!-- ── Chú thích bản đồ (góc trái, dưới top bar) ── -->
        <AbsoluteLayout AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All"
                        InputTransparent="True">
            <Border x:Name="MapLegendBorder" x:FieldModifier="public"
                    HorizontalOptions="Start" VerticalOptions="Start"
                    Margin="12,108,0,0"
                    StrokeShape="RoundRectangle 12" BackgroundColor="#0E1E17"
                    Stroke="#1C3024" StrokeThickness="1" Padding="10,8">
                <VerticalStackLayout Spacing="5">
                    <Label Text="CHÚ THÍCH" FontSize="9" FontAttributes="Bold"
                           TextColor="#6B7280" CharacterSpacing="1" HorizontalOptions="Center"/>
                    <HorizontalStackLayout Spacing="7">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                 BackgroundColor="#3B82F6" VerticalOptions="Center"/>
                        <Label Text="Gần đây" FontSize="10" TextColor="#D1D5DB" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="7">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                 BackgroundColor="#9333EA" VerticalOptions="Center"/>
                        <Label Text="Đã ghé" FontSize="10" TextColor="#D1D5DB" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="7">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                 BackgroundColor="#FBBF24" VerticalOptions="Center"/>
                        <Label Text="Đã lưu" FontSize="10" TextColor="#D1D5DB" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="7">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                 BackgroundColor="#F97316" VerticalOptions="Center"/>
                        <Label Text="Chưa ghé" FontSize="10" TextColor="#D1D5DB" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </AbsoluteLayout>

        <!-- ── Controls phải: Zoom + My Location ── -->
        <VerticalStackLayout AbsoluteLayout.LayoutBounds="1,0,-1,-1"
                             AbsoluteLayout.LayoutFlags="PositionProportional"
                             WidthRequest="44" Margin="0,110,12,0" Spacing="10">

            <!-- Zoom card: + / − -->
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="#1C1C1C" Stroke="#2A2A2A"
                    WidthRequest="44" HorizontalOptions="Center" Padding="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.35" Radius="8" Offset="0,3"/></Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Grid WidthRequest="44" HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoomInTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="+" FontSize="22" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#3A3A3A"
                             HorizontalOptions="Fill" Margin="8,0"/>
                    <Grid WidthRequest="44" HeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoomOutTapped"/>
                        </Grid.GestureRecognizers>
                        <Label Text="−" FontSize="24" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- My Location – nút định vị: nền cam nhạt, icon mũi tên trắng, viền cam -->
            <Border StrokeShape="RoundRectangle 24"
                    Stroke="#F97316" StrokeThickness="1.5"
                    WidthRequest="48" HeightRequest="48" HorizontalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3A1A00" Offset="0"/>
                        <GradientStop Color="#1C1C1C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#F97316" Opacity="0.30" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCenterMapTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#xF034E;" FontFamily="MDI" FontSize="24" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- 🔄 DEBUG: Reset Database Button (màu đỏ) -->
            <Border StrokeShape="RoundRectangle 24"
                    Stroke="#EF4444" StrokeThickness="1.5"
                    WidthRequest="48" HeightRequest="48" HorizontalOptions="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3A0000" Offset="0"/>
                        <GradientStop Color="#1C0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#EF4444" Opacity="0.30" Radius="10" Offset="0,3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnResetDatabaseTapped"/>
                </Border.GestureRecognizers>
                <Label Text="&#xF0450;" FontFamily="MDI" FontSize="24" TextColor="White"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

        </VerticalStackLayout>

    </AbsoluteLayout>
</ContentView>
