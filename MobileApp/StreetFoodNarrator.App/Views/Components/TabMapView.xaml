<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StreetFoodNarrator.App.ViewModels"
             xmlns:models="clr-namespace:StreetFoodNarrator.App.Core.Models"
             xmlns:components="clr-namespace:StreetFoodNarrator.App.Views.Components"
             x:Class="StreetFoodNarrator.App.Views.Components.TabMapView"
             x:DataType="vm:MainViewModel">

    <AbsoluteLayout BackgroundColor="Transparent"
                    InputTransparent="True"
                    CascadeInputTransparent="False">

        <!-- ══════════════════════════════════════════════════════════════
             HEADER BAR  — nền đặc #0A1612, kéo sát lên trên hơn
             [←]  STREET FOOD NARRATOR  [≡ filter]
             ══════════════════════════════════════════════════════════════ -->
        <Grid AbsoluteLayout.LayoutBounds="0,0,1,68"
              AbsoluteLayout.LayoutFlags="WidthProportional"
              InputTransparent="False"
              Padding="16,22,16,8"
              BackgroundColor="#0A1612">

            <Grid ColumnDefinitions="48,*,48" VerticalOptions="Center">

                <!-- Nút Back — MDI arrow-left F004D -->
                <Border Grid.Column="0"
                        WidthRequest="48" HeightRequest="48"
                        BackgroundColor="#112019"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xF004D;"
                           FontFamily="MDI" FontSize="20"
                           TextColor="#4BE277"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Tiêu đề -->
                <Label Grid.Column="1"
                       Text="STREET FOOD NARRATOR"
                       FontSize="15" FontAttributes="Bold"
                       CharacterSpacing="1.8"
                       TextColor="#4BE277"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       Margin="8,0"/>

                <!-- Nút Filter — MDI tune/sliders F066E, giống Image 2 -->
                <Border Grid.Column="2"
                        WidthRequest="48" HeightRequest="48"
                        BackgroundColor="#112019"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFilterTapped"/>
                    </Border.GestureRecognizers>
                    <Label Text="&#xF066E;"
                           FontFamily="MDI" FontSize="22"
                           TextColor="#4BE277"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════
             SEARCH BAR + MAP LEGEND / CONTROLS
             Bỏ suggest loại món, thay bằng legend màu cho trạng thái pin.
             ══════════════════════════════════════════════════════════════ -->
        <VerticalStackLayout AbsoluteLayout.LayoutBounds="0,84,1,-1"
                             AbsoluteLayout.LayoutFlags="WidthProportional"
                             InputTransparent="False"
                             Spacing="10"
                             Padding="16,0">

            <!-- Search bar -->
            <Border BackgroundColor="#08120F"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 34"
                    HeightRequest="64"
                    Padding="18,0">
                <Grid ColumnDefinitions="32,*,36" ColumnSpacing="10">

                    <!-- MDI magnify F0349 -->
                    <Label Grid.Column="0"
                           Text="&#xF0349;"
                           FontFamily="MDI" FontSize="22"
                           TextColor="#4BE277"
                           VerticalOptions="Center"/>

                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="Tìm quán ăn..."
                           PlaceholderColor="#5A6E65"
                           TextColor="#D8E6DF"
                           FontSize="16"
                           BackgroundColor="Transparent"
                           VerticalOptions="Center"
                           HeightRequest="54"
                           Text="{Binding SearchQuery}"
                           TextChanged="OnSearchTextChanged"/>

                    <!-- X button — hiện khi HasSearchText = true -->
                    <Border Grid.Column="2"
                            IsVisible="{Binding HasSearchText}"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            WidthRequest="36" HeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClearSearchTapped"/>
                        </Border.GestureRecognizers>
                        <!-- MDI close F0156 -->
                        <Label Text="&#xF0156;"
                               FontFamily="MDI" FontSize="20"
                               TextColor="#6E7C76"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,56"
                  ColumnSpacing="12"
                  VerticalOptions="Start">

                <Border Grid.Column="0"
                        BackgroundColor="#15211D"
                        Stroke="#20312A"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="12,10"
                        HorizontalOptions="Start"
                        VerticalOptions="Start">
                    <VerticalStackLayout Spacing="9">
                        <HorizontalStackLayout Spacing="7">
                            <Border WidthRequest="10"
                                    HeightRequest="10"
                                    BackgroundColor="#F97316"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    VerticalOptions="Center"/>
                            <Label Text="Chưa xem"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#D6E3DD"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="7">
                            <Border WidthRequest="10"
                                    HeightRequest="10"
                                    BackgroundColor="#9333EA"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    VerticalOptions="Center"/>
                            <Label Text="Đã xem"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#D6E3DD"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="7">
                            <Border WidthRequest="10"
                                    HeightRequest="10"
                                    BackgroundColor="#FBBF24"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    VerticalOptions="Center"/>
                            <Label Text="Đã lưu"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="#D6E3DD"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="10"
                                     HorizontalOptions="End">
                    <Border WidthRequest="52" HeightRequest="52"
                            BackgroundColor="#12211B"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,-2" Radius="20" Opacity="0.30"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoomInTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="+"
                               FontSize="26" FontAttributes="Bold"
                               TextColor="#E5EFE9"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Border WidthRequest="52" HeightRequest="52"
                            BackgroundColor="#12211B"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="14" Opacity="0.24"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnZoomOutTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="−"
                               FontSize="28" FontAttributes="Bold"
                               TextColor="#E5EFE9"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Border WidthRequest="52" HeightRequest="52"
                            BackgroundColor="#12211B"
                            Stroke="#F97316"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 26">
                        <Border.Shadow>
                            <Shadow Brush="#F97316" Offset="0,4" Radius="16" Opacity="0.22"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCenterMapTapped"/>
                        </Border.GestureRecognizers>
                        <Label Text="&#xF034E;"
                               FontFamily="MDI" FontSize="22"
                               TextColor="#F7FBF8"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Hidden legacy chip container kept to avoid touching selection logic elsewhere -->
            <HorizontalStackLayout x:Name="FilterChipsContainer"
                                   IsVisible="False"
                                   HeightRequest="0"
                                   Spacing="10"
                                   BindableLayout.ItemsSource="{Binding Categories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="#2B3733"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28"
                                Padding="20,13"
                                MinimumHeightRequest="48"
                                MinimumWidthRequest="72">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryChipTapped"
                                                      CommandParameter="{Binding}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#BCCBB9"
                                   VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Hidden legacy suggestions host kept so code-behind can no-op safely -->
        <Border x:Name="SuggestionsDropdown"
                AbsoluteLayout.LayoutBounds="0,0,0,0"
                AbsoluteLayout.LayoutFlags="WidthProportional"
                InputTransparent="False"
                IsVisible="False"
                BackgroundColor="#15211D"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                Opacity="0"
                HeightRequest="0">

            <CollectionView x:Name="SuggestionsList"
                            SelectionMode="None"
                            IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:POI">
                        <Grid ColumnDefinitions="56,*,Auto"
                              ColumnSpacing="12"
                              Padding="14,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSuggestionTapped"/>
                            </Grid.GestureRecognizers>

                            <Border Grid.Column="0"
                                    WidthRequest="52" HeightRequest="52"
                                    StrokeThickness="0"
                                    BackgroundColor="#25322D"
                                    StrokeShape="RoundRectangle 16">
                                <Image Source="{Binding DisplayImageUrl}"
                                       Aspect="AspectFill"
                                       WidthRequest="52" HeightRequest="52"/>
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding Name_Vi}"
                                       FontSize="15" FontAttributes="Bold"
                                       TextColor="#E8F3EE"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding SignatureDish}"
                                       FontSize="12" TextColor="#8D9B95"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    BackgroundColor="#1D2A25"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Label Text="{Binding ZoneType}"
                                       FontSize="10" FontAttributes="Bold"
                                       TextColor="#4BE277"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             POI QUICK CARD — giống Image 2
             Nền #15211D, bo 32, cách bottom nav 118pt.
             Bind vào SelectedPinPOI (dùng trong .cs: vm.SelectedPinPOI).
             Row 0: [Ảnh ⌀80] [Tên / ★ Rating / Khoảng cách] [♥]
             Row 1: [←]       [XEM CHI TIẾT →]                [→]
             ══════════════════════════════════════════════════════════════ -->
        <Border AbsoluteLayout.LayoutBounds="0.5,1,1,-1"
                AbsoluteLayout.LayoutFlags="WidthProportional,PositionProportional"
                Margin="18,0,18,112"
                InputTransparent="False"
                IsVisible="{Binding IsMapPoiCardVisible}"
                BackgroundColor="#15211D"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30"
                Padding="16">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,-6" Radius="32" Opacity="0.40"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="14">

                <!-- ── Row 0: Info ── -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="82,*,40"
                      ColumnSpacing="12">

                    <!-- Ảnh tròn ⌀80 -->
                    <Border Grid.Column="0"
                            WidthRequest="72" HeightRequest="72"
                            BackgroundColor="#FFFFFF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 36">
                        <Image Source="{Binding SelectedPinPOI.DisplayImageUrl}"
                               Aspect="AspectFill"
                               WidthRequest="72" HeightRequest="72"/>
                    </Border>

                    <!-- Tên + Rating -->
                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4"
                                         VerticalOptions="Center">
                        <Label Text="{Binding SelectedPinPOI.Name_Vi, FallbackValue='Phở Hà Nội'}"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="#F0F7F3"
                               LineBreakMode="TailTruncation"/>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="★" FontSize="13" TextColor="#FFB690"/>
                            <Label Text="{Binding SelectedPinPOI.Rating,
                                           StringFormat='{}{0:F1}',
                                           FallbackValue='4.8'}"
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="#F0F7F3"/>
                            <Label Text="•" FontSize="12" TextColor="#8B9A93"/>
                            <Label Text="{Binding CurrentPoiDistanceText, FallbackValue='0.2 dặm'}"
                                   FontSize="12" TextColor="#C6D2CC"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- ♥ Like button — icon toggle bởi RefreshLikeIcon() trong .cs -->
                    <Border Grid.Column="2"
                            WidthRequest="40" HeightRequest="40"
                            BackgroundColor="Transparent"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLikeTapped"/>
                        </Border.GestureRecognizers>
                        <!--
                            Icon mặc định = outline &#xF1437; (sửa lỗi 5-hex cũ).
                            .cs sẽ gọi RefreshLikeIcon() để đổi sang filled &#xF1438; khi saved.
                        -->
                        <Label x:Name="LikeIcon"
                               Text="&#xF1437;"
                               FontFamily="MDI" FontSize="24"
                               TextColor="#6BFF8F"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <!-- ── Row 1: Buttons ── -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="*">

                    <!-- XEM CHI TIẾT — gradient xanh -->
                    <Border Grid.Column="0"
                            HeightRequest="52"
                            Margin="6,0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 26">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4BE277" Offset="0.0"/>
                                <GradientStop Color="#22C55E" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#4BE277" Offset="0,3" Radius="20" Opacity="0.20"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewDetailTapped"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                            <Label Text="XEM CHI TIẾT"
                                   FontSize="13" FontAttributes="Bold"
                                   CharacterSpacing="0.6"
                                   TextColor="#063014"
                                   VerticalOptions="Center"/>
                            <!-- MDI arrow-right F0142 -->
                            <Label Text="&#xF0142;"
                                   FontFamily="MDI" FontSize="18"
                                   TextColor="#063014"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             FLOATING BOTTOM NAV
             Active tab = pill xanh (giống Image 2).
             ══════════════════════════════════════════════════════════════ -->
        <components:FloatingBottomNav
            AbsoluteLayout.LayoutBounds="0.5,1,1,-1"
            AbsoluteLayout.LayoutFlags="WidthProportional,PositionProportional"
            Margin="0,0,0,-10"
            InputTransparent="False"
            SavedNavRequested="OnSavedNavTapped"
            ProfileNavRequested="OnProfileNavTapped"
            ExploreNavRequested="OnExploreNavTapped"
            ActiveTab="Explore"/>

    </AbsoluteLayout>
</ContentView>
