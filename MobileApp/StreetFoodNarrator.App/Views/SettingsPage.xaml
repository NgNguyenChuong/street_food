<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:StreetFoodNarrator.App.Converters"
             x:Class="StreetFoodNarrator.App.Views.SettingsPage"
             BackgroundColor="#0A1612"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:GenderToEmojiConverter x:Key="GenderToEmojiConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BackgroundColor="#0F1F17"
                Padding="20,16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,20,20" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="&#xF004D;"
                        FontFamily="MDI"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        Clicked="OnBackClicked"
                        WidthRequest="40" />

                <Label Grid.Column="1"
                       x:Name="TitleLabel"
                       Text="Cài đặt"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <Button Grid.Column="2"
                    x:Name="HeaderLanguageButton"
                    Text="VI"
                    FontSize="12"
                    FontAttributes="Bold"
                    BackgroundColor="#1A2925"
                    TextColor="#22C55E"
                    BorderColor="#2B4B40"
                    BorderWidth="1"
                    CornerRadius="10"
                    WidthRequest="52"
                    HeightRequest="36"
                    Clicked="OnHeaderLanguageClicked"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16" Padding="20,20,20,100">

                <Border BackgroundColor="#0F1F17" Stroke="#1E3D2A" StrokeThickness="1" Padding="20,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="14">
                        <Label x:Name="GeneralSectionLabel"
                               Text="Tổng quan"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#22C55E" />

                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="LanguageTitleLabel"
                                Text="Ngôn ngữ"
                                   FontSize="12"
                                   TextColor="#64748B"
                                   CharacterSpacing="1" />
                            <Border Stroke="#1E3D2A" StrokeThickness="1" BackgroundColor="#1A2925" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="LanguageValueLabel"
                                           Text="VI - Tiếng Việt"
                                           FontSize="14"
                                           TextColor="White"
                                           VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1"
                                           Text="&#xF0142;"
                                           FontFamily="MDI"
                                           FontSize="16"
                                           TextColor="#64748B"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLanguageSelectionTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#1E3D2A" Opacity="0.5" />

                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="LocationSourceTitleLabel"
                                   Text="Nguồn vị trí"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Label x:Name="LocationSourceSubtitleLabel"
                                   Text="Chọn GPS thật hoặc GPS giả lập khi test"
                                   FontSize="12"
                                   TextColor="#64748B" />
                            <Border Stroke="#1E3D2A" StrokeThickness="1" BackgroundColor="#1A2925" Padding="12,10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="LocationSourceValueLabel"
                                           Text="GPS thật (mặc định)"
                                           FontSize="14"
                                           TextColor="White"
                                           VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1"
                                           Text="&#xF0142;"
                                           FontFamily="MDI"
                                           FontSize="16"
                                           TextColor="#64748B"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLocationSourceSelectionTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#1E3D2A" Opacity="0.5" />

                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label x:Name="GpsTestModeTitleLabel"
                                           Text="GPS test mode"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="GpsTestModeSubtitleLabel"
                                         Text="Bat de tao ngay 3 POI test theo toa do co dinh"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Switch x:Name="GpsTestModeSwitch"
                                        Grid.Column="1"
                                        OnColor="#22C55E"
                                        ThumbColor="White"
                                        Toggled="OnGpsTestModeToggled"
                                        VerticalOptions="Center" />
                            </Grid>

                            <Label x:Name="GpsTestCoordinateLabel"
                                        Text="Tao dung 3 diem GPS test voi priority 10, 9, 8 ngay khi bat mode"
                                        FontSize="12"
                                   TextColor="#94A3B8" />
                        </VerticalStackLayout>

                                   <BoxView HeightRequest="1" BackgroundColor="#1E3D2A" Opacity="0.5" />

                                   <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="4">
                                        <Label x:Name="SimulationToolsTitleLabel"
                                            Text="Hiện nút giả lập ExploreMap"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            TextColor="White" />
                                        <Label x:Name="SimulationToolsSubtitleLabel"
                                            Text="Bật để hiện cụm nút simulate phục vụ test nhanh"
                                            FontSize="12"
                                            TextColor="#64748B" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="SimulationToolsSwitch"
                                         Grid.Column="1"
                                         OnColor="#22C55E"
                                         ThumbColor="White"
                                         Toggled="OnSimulationToolsToggled"
                                         VerticalOptions="Center" />
                                   </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#1E3D2A" Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="HapticTitleLabel"
                                    Text="Rung phản hồi"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label x:Name="HapticSubtitleLabel"
                                    Text="Rung nhẹ khi thao tác chính"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Switch x:Name="HapticFeedbackSwitch"
                                    Grid.Column="1"
                                    OnColor="#22C55E"
                                    ThumbColor="White"
                                    Toggled="OnHapticFeedbackToggled"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#1E3D2A" Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="KeepScreenOnTitleLabel"
                                    Text="Giữ màn hình sáng"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label x:Name="KeepScreenOnSubtitleLabel"
                                    Text="Không tắt màn hình khi đang dùng app"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Switch x:Name="KeepScreenOnSwitch"
                                    Grid.Column="1"
                                    OnColor="#22C55E"
                                    ThumbColor="White"
                                    Toggled="OnKeepScreenOnToggled"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#1E3D2A" Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="LargeTextTitleLabel"
                                    Text="Văn bản lớn"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label x:Name="LargeTextSubtitleLabel"
                                    Text="Ưu tiên cỡ chữ lớn hơn cho dễ đọc"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Switch x:Name="LargeTextSwitch"
                                    Grid.Column="1"
                                    OnColor="#22C55E"
                                    ThumbColor="White"
                                    Toggled="OnLargeTextToggled"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#0F1F17" Stroke="#1E3D2A" StrokeThickness="1" Padding="20,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <Label x:Name="TourSectionLabel"
                               Text="Trải nghiệm tour"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#22C55E" />

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label x:Name="TtsTitleLabel"
                                           Text="Giọng đọc"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="TtsSubtitleLabel"
                                           Text="Chọn giọng đọc cho thuyết minh"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       x:Name="TtsExpandIcon"
                                       Text="&#xF0140;"
                                       FontFamily="MDI"
                                       FontSize="16"
                                       TextColor="#64748B"
                                       VerticalTextAlignment="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTtsClicked" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <VerticalStackLayout x:Name="VoicePickerContainer" IsVisible="False" Spacing="8">
                                <Border Stroke="#1E3D2A" StrokeThickness="1" BackgroundColor="#1E3D2A">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="12,8">
                                        <Label Grid.Column="0"
                                               Text="&#xF036C;"
                                               FontFamily="MDI"
                                               FontSize="20"
                                               TextColor="#F59E0B"
                                               VerticalTextAlignment="Center"
                                               Margin="0,0,8,0" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label x:Name="SelectedVoiceName"
                                                   Text="Hoài My (Nữ)"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                            <Label x:Name="SelectedVoiceLanguage"
                                                   Text="Tiếng Việt"
                                                   FontSize="11"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                            <Button x:Name="TestVoiceButton"
                                                    Text="&#xF040A;"
                                                    FontFamily="MDI"
                                                    FontSize="12"
                                                    BackgroundColor="#22C55E"
                                                    TextColor="White"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    CornerRadius="18"
                                                    Padding="0"
                                                    Clicked="OnTestVoiceClicked" />
                                            <Button x:Name="TestFallbackButton"
                                                    Text="N"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="#F97316"
                                                    TextColor="White"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    CornerRadius="18"
                                                    Padding="0"
                                                    Clicked="OnTestFallbackTtsClicked" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>

                                <CollectionView x:Name="VoiceListView" MaximumHeightRequest="220">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  Padding="12,10"
                                                  BackgroundColor="Transparent">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnVoiceSelected" />
                                                </Grid.GestureRecognizers>

                                                <Label Grid.Column="0"
                                                       Text="{Binding Gender, Converter={StaticResource GenderToEmojiConverter}}"
                                                       FontSize="18"
                                                       VerticalTextAlignment="Center"
                                                       Margin="0,0,10,0" />

                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="13"
                                                           TextColor="White" />
                                                    <Label Text="{Binding Language}"
                                                           FontSize="11"
                                                           TextColor="#64748B" />
                                                </VerticalStackLayout>

                                                <Label Grid.Column="2"
                                                       Text="&#xF012C;"
                                                       FontFamily="MDI"
                                                       FontSize="16"
                                                       TextColor="#22C55E"
                                                       VerticalTextAlignment="Center"
                                                       IsVisible="{Binding IsSelected}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" BackgroundColor="#1E3D2A" Opacity="0.5" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="AutoPlayTitleLabel"
                                       Text="Tự phát"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label x:Name="AutoPlaySubtitleLabel"
                                       Text="Tự phát thuyết minh khi vào vùng"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Switch x:Name="AutoPlaySwitch"
                                    Grid.Column="1"
                                    IsToggled="True"
                                    OnColor="#22C55E"
                                    ThumbColor="White"
                                    Toggled="OnAutoPlayToggled"
                                    VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="VolumeTitleLabel"
                                       Text="Âm lượng"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label x:Name="VolumeValueLabel"
                                       Grid.Column="1"
                                       Text="80%"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#22C55E"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                            <Slider x:Name="VolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="80"
                                    MinimumTrackColor="#22C55E"
                                    MaximumTrackColor="#1E3D2A"
                                    ThumbColor="#22C55E"
                                    ValueChanged="OnVolumeChanged" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#2A1212" Stroke="#7F1D1D" StrokeThickness="1" Padding="20,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Text="&#xF034A;"
                                   FontFamily="MDI"
                                   FontSize="20"
                                   TextColor="#FCA5A5"
                                   VerticalTextAlignment="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="LogoutTitleLabel"
                                    Text="Đăng xuất"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#FCA5A5" />
                                <Label x:Name="LogoutSubtitleLabel"
                                    Text="Thoát khỏi phiên hiện tại và đóng ứng dụng"
                                       FontSize="12"
                                       TextColor="#FECACA" />
                            </VerticalStackLayout>
                        </Grid>

                           <Button x:Name="LogoutButton"
                                Text="Đăng xuất"
                                BackgroundColor="#DC2626"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="44"
                                Clicked="OnLogoutClicked" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">
                    <Button x:Name="DefaultBackButton"
                            Text="Quay về mặc định"
                            BackgroundColor="#1A2925"
                            BorderColor="#2B4B40"
                            BorderWidth="1"
                            TextColor="#D8E6DF"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46"
                            Clicked="OnResetDefaultsClicked" />
                    <Button x:Name="SaveSettingsButton"
                            Grid.Column="1"
                            Text="Lưu thay đổi"
                            BackgroundColor="#22C55E"
                            TextColor="#052e16"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46"
                            Clicked="OnSaveChangesClicked" />
                </Grid>

                <VerticalStackLayout Spacing="8" Margin="0,16,0,0" HorizontalOptions="Center">
                    <Label x:Name="FooterPolicyLabel"
                           Text="Nguon du lieu: ..."
                           FontSize="12"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="FooterVersionLabel"
                           Text="Phiên bản 1.0.0"
                           FontSize="11"
                           TextColor="#475569"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
