<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resx="clr-namespace:StreetFoodNarrator.App.Resources.Strings"
             x:Class="StreetFoodNarrator.App.Views.SettingsPage"
             BackgroundColor="#0A1612"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">
        <!-- ═══════════════════════════════════════════════════
             TOP: Header with back button
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                BackgroundColor="#0F1F17"
                Padding="20,16">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,20,20" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="24"
                        BackgroundColor="Transparent"
                        TextColor="White"
                        Clicked="OnBackClicked"
                        WidthRequest="40" />

                <Label Grid.Column="1"
                       x:Name="TitleLabel"
                       Text="{x:Static resx:AppStrings.Settings_Title}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             CONTENT: Card-based layout
             ═══════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16"
                                 Padding="20,20,20,100">

                <!-- ────────────────────────────────────────────
                     CARD 1: Language & Account
                     ──────────────────────────────────────────── -->
                <Border BackgroundColor="#0F1F17"
                        Stroke="#1E3D2A"
                        StrokeThickness="1"
                        Padding="20,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <!-- Section title -->
                        <Label x:Name="GeneralSectionLabel"
                               Text="{x:Static resx:AppStrings.Settings_General}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#22C55E" />

                        <!-- Language selector (dropdown) -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Ngôn ngữ"
                                   FontSize="13"
                                   TextColor="#94A3B8" />
                            <Picker x:Name="LanguagePicker"
                                    Title="Chọn ngôn ngữ"
                                    FontSize="14"
                                    TextColor="White"
                                    TitleColor="#64748B"
                                    BackgroundColor="#1A2925"
                                    HeightRequest="48"
                                    SelectedIndexChanged="OnLanguagePickerSelectionChanged" />
                        </VerticalStackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#1E3D2A"
                                 Opacity="0.5" />

                        <!-- Google Login -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    BackgroundColor="#22C55E20"
                                    WidthRequest="44"
                                    HeightRequest="44">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="G"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#22C55E"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 VerticalOptions="Center">
                                <Label x:Name="GoogleLoginLabel"
                                       Text="{x:Static resx:AppStrings.Settings_LoginGoogle}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="Đăng nhập để đồng bộ"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="→"
                                   FontSize="20"
                                   TextColor="#64748B"
                                   VerticalTextAlignment="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoogleLoginClicked" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ────────────────────────────────────────────
                     CARD 2: Tour Experience
                     ──────────────────────────────────────────── -->
                <Border BackgroundColor="#0F1F17"
                        Stroke="#1E3D2A"
                        StrokeThickness="1"
                        Padding="20,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <!-- Section title -->
                        <Label x:Name="TourSectionLabel"
                               Text="{x:Static resx:AppStrings.Settings_TourExperience}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#22C55E" />

                        <!-- TTS Voice -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label x:Name="TtsTitleLabel"
                                           Text="{x:Static resx:AppStrings.Settings_Tts}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label x:Name="TtsSubtitleLabel"
                                           Text="{x:Static resx:AppStrings.Settings_TtsSubtitle}"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       x:Name="TtsExpandIcon"
                                       Text="▼"
                                       FontSize="16"
                                       TextColor="#64748B"
                                       VerticalTextAlignment="Center" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTtsClicked" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            
                            <!-- Voice Picker (Expandable) -->
                            <VerticalStackLayout x:Name="VoicePickerContainer"
                                                 IsVisible="False"
                                                 Spacing="8">
                                <BoxView HeightRequest="1"
                                         BackgroundColor="#1E3D2A"
                                         Opacity="0.5" />
                                
                                <!-- Selected Voice Display -->
                                <Border Stroke="#1E3D2A"
                                        StrokeThickness="1"
                                        BackgroundColor="#1E3D2A">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          Padding="12,8">
                                        <Label Grid.Column="0"
                                               Text="🎤"
                                               FontSize="20"
                                               VerticalTextAlignment="Center"
                                               Margin="0,0,8,0" />
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2">
                                            <Label x:Name="SelectedVoiceName"
                                                   Text="Hoài My (Nữ)"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="White" />
                                            <Label x:Name="SelectedVoiceLanguage"
                                                   Text="Vietnamese"
                                                   FontSize="11"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2"
                                                x:Name="TestVoiceButton"
                                                Text="▶"
                                                FontSize="12"
                                                BackgroundColor="#22C55E"
                                                TextColor="White"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                CornerRadius="18"
                                                Padding="0"
                                                Clicked="OnTestVoiceClicked" />
                                    </Grid>
                                </Border>
                                
                                <!-- Voice List -->
                                <CollectionView x:Name="VoiceListView"
                                                MaximumHeightRequest="200">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  Padding="12,10"
                                                  BackgroundColor="Transparent">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnVoiceSelected" />
                                                </Grid.GestureRecognizers>
                                                
                                                <Label Grid.Column="0"
                                                       Text="{Binding Gender, Converter={StaticResource GenderToEmojiConverter}}"
                                                       FontSize="18"
                                                       VerticalTextAlignment="Center"
                                                       Margin="0,0,10,0" />
                                                       
                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="2">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="13"
                                                           TextColor="White" />
                                                    <Label Text="{Binding Language}"
                                                           FontSize="11"
                                                           TextColor="#64748B" />
                                                </VerticalStackLayout>
                                                
                                                <Label Grid.Column="2"
                                                       Text="✓"
                                                       FontSize="16"
                                                       TextColor="#22C55E"
                                                       VerticalTextAlignment="Center"
                                                       IsVisible="{Binding IsSelected}" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#1E3D2A"
                                 Opacity="0.5" />

                        <!-- Auto play -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="AutoPlayTitleLabel"
                                       Text="{x:Static resx:AppStrings.Settings_AutoPlay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label x:Name="AutoPlaySubtitleLabel"
                                       Text="{x:Static resx:AppStrings.Settings_AutoPlayDesc}"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Switch x:Name="AutoPlaySwitch"
                                    Grid.Column="1"
                                    IsToggled="True"
                                    OnColor="#22C55E"
                                    ThumbColor="White"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#1E3D2A"
                                 Opacity="0.5" />

                        <!-- Volume -->
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="VolumeTitleLabel"
                                       Text="{x:Static resx:AppStrings.Settings_Volume}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Grid.Column="1"
                                       x:Name="VolumeValueLabel"
                                       Text="80%"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#22C55E"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                            <Slider x:Name="VolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="80"
                                    MinimumTrackColor="#22C55E"
                                    MaximumTrackColor="#1E3D2A"
                                    ThumbColor="#22C55E" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1"
                                 BackgroundColor="#1E3D2A"
                                 Opacity="0.5" />

                        <!-- Sensitivity -->
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label x:Name="SensitivityTitleLabel"
                                       Text="{x:Static resx:AppStrings.Settings_Sensitivity}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Grid.Column="1"
                                       x:Name="SensitivityValueLabel"
                                       Text="40m"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#22C55E"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                            <Slider x:Name="SensitivitySlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="40"
                                    MinimumTrackColor="#22C55E"
                                    MaximumTrackColor="#1E3D2A"
                                    ThumbColor="#22C55E" />
                            <Grid ColumnDefinitions="*,*">
                                <Label x:Name="SensitivityLeftLabel"
                                       Text="{x:Static resx:AppStrings.Settings_SensitivityNear}"
                                       FontSize="11"
                                       TextColor="#64748B" />
                                <Label Grid.Column="1"
                                       x:Name="SensitivityRightLabel"
                                       Text="{x:Static resx:AppStrings.Settings_SensitivityFar}"
                                       FontSize="11"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ────────────────────────────────────────────
                     CARD 3: Data Management
                     ──────────────────────────────────────────── -->
                <Border BackgroundColor="#0F1F17"
                        Stroke="#1E3D2A"
                        StrokeThickness="1"
                        Padding="20,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="16">
                        <!-- Section title -->
                        <Label x:Name="DataSectionLabel"
                               Text="{x:Static resx:AppStrings.Settings_Data}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#22C55E" />

                        <!-- Offline status -->
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    BackgroundColor="#22C55E20"
                                    WidthRequest="44"
                                    HeightRequest="44">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="✓"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#22C55E"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="Dữ liệu offline"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label Text="7 quán • 2.4 MB • Cập nhật 2h trước"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Action buttons -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    x:Name="CheckOfflineButton"
                                    Text="🔄 Cập nhật"
                                    BackgroundColor="#1A2925"
                                    TextColor="#94A3B8"
                                    BorderColor="#2A3F37"
                                    BorderWidth="1"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    FontSize="13"
                                    Clicked="OnCheckOfflineClicked" />
                            <Button Grid.Column="1"
                                    Text="🗑️ Xóa"
                                    BackgroundColor="#EF444420"
                                    TextColor="#EF4444"
                                    BorderColor="#EF4444"
                                    BorderWidth="1"
                                    CornerRadius="12"
                                    HeightRequest="44"
                                    FontSize="13"
                                    Clicked="OnDeleteDataClicked" />
                        </Grid>

                        <Label x:Name="LastUpdatedLabel"
                               Text="{x:Static resx:AppStrings.Settings_LastUpdated}"
                               FontSize="11"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!--   Footer -->
                <VerticalStackLayout Spacing="8"
                                     Margin="0,16,0,0"
                                     HorizontalOptions="Center">
                    <Label x:Name="FooterPolicyLabel"
                           Text="{x:Static resx:AppStrings.Settings_PrivacyTerms}"
                           FontSize="12"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="FooterVersionLabel"
                           Text="{x:Static resx:AppStrings.Settings_Version}"
                           FontSize="11"
                           TextColor="#475569"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Made by Mixicon"
                           FontSize="10"
                           TextColor="#22C55E40"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
