<?xml version="1.0" encoding="utf-8" ?>
<!--
    TourPage.xaml – Tab Tour (Hành trình)
    Layer 0: Bản đồ Mapsui (luôn hiện làm nền)
    Layer 1: TabTourView overlay (header + bottom sheet)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StreetFoodNarrator.App.ViewModels"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:components="clr-namespace:StreetFoodNarrator.App.Views.Components"
             x:Class="StreetFoodNarrator.App.Views.TourPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A1612">

    <Grid>
        <!-- ── Layer 0: Bản đồ OSM (luôn visible, làm nền) ── -->
        <mapsui:MapControl x:Name="TourMapView"
                           BackgroundColor="#0A1612"/>

        <!-- ── Layer 1: Tour UI Overlay (header + bottom sheet) ── -->
        <components:TabTourView x:Name="TourContent"
                                ZIndex="10"/>
    </Grid>

</ContentPage>
