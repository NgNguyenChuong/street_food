<?xml version="1.0" encoding="utf-8" ?>
<!--
    SavedPage.xaml - Tab Đã lưu
    Gộp Danh sách tour + Đã lưu
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StreetFoodNarrator.App.ViewModels"
             xmlns:components="clr-namespace:StreetFoodNarrator.App.Views.Components"
             x:Class="StreetFoodNarrator.App.Views.SavedPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#0A1612"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid RowDefinitions="Auto,*" Padding="0,0,0,100">

        <Border Grid.RowSpan="2"
                Margin="16,10,16,0"
                Padding="10,8"
                HorizontalOptions="Fill"
                VerticalOptions="Start"
                BackgroundColor="#D97706EE"
                Stroke="#F59E0B"
                StrokeThickness="1"
                IsVisible="{Binding ShowOfflineBanner}"
                ZIndex="2000">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="OfflineBannerLabel" Text="Bạn đang ngoại tuyến. Nên bật mạng để trải nghiệm tốt hơn."
                       FontSize="11"
                       TextColor="White"
                       VerticalTextAlignment="Center"/>
                <Button Grid.Column="1"
                        WidthRequest="26"
                        HeightRequest="26"
                        CornerRadius="13"
                        Padding="0"
                        FontFamily="MDI"
                        FontSize="14"
                        Text="&#xF0156;"
                        TextColor="White"
                        BackgroundColor="#00000000"
                        Command="{Binding DismissOfflineBannerCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="0" ColumnDefinitions="*,*,Auto" Margin="16,12" ColumnSpacing="8">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 12"
                    BackgroundColor="#1C3024" Padding="0,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSegmentBrowseTapped"/>
                </Border.GestureRecognizers>
                <Label x:Name="LabelBrowse" Text="Danh sách tour" FontSize="12"
                       TextColor="#6B7280" HorizontalOptions="Center"/>
            </Border>
            <Border Grid.Column="1" StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F5A623" Padding="0,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSegmentSavedTapped"/>
                </Border.GestureRecognizers>
                <Label x:Name="LabelSaved" Text="Đã lưu" FontSize="12" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center"/>
            </Border>

            <Button Grid.Column="2"
                    x:Name="HeaderLanguageButton"
                    Text="VI"
                    WidthRequest="50"
                    HeightRequest="42"
                    CornerRadius="12"
                    FontSize="12"
                    FontAttributes="Bold"
                    BackgroundColor="#1C3024"
                    BorderColor="#2B4B40"
                    BorderWidth="1"
                    TextColor="#4BE277"
                    Clicked="OnHeaderLanguageClicked"/>
        </Grid>

        <Grid Grid.Row="1">
            <ContentView x:Name="BrowseHost" IsVisible="False"/>
            <components:TabSavedView x:Name="SavedContent" IsVisible="True"/>
        </Grid>

        </Grid>

        <components:FloatingBottomNav ActiveTab="Saved" VerticalOptions="End"/>
    </Grid>
</ContentPage>
