<?xml version="1.0" encoding="UTF-8" ?>
<!--
    AppShell.xaml – Bottom Navigation thống nhất cho toàn app
    4 tab cố định: Bản đồ | Tour | Đã lưu | Cá nhân
    Màu sắc: #1A0D05 nền, #F5A623 active, #5D3A1A inactive
-->
<Shell
    x:Class="StreetFoodNarrator.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:StreetFoodNarrator.App.Views"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled">

    <Shell.Resources>
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarBackgroundColor" Value="#0A1612"/>
            <Setter Property="Shell.TabBarForegroundColor" Value="#F5A623"/>
            <Setter Property="Shell.TabBarUnselectedColor" Value="#5D3A1A"/>
            <Setter Property="Shell.TabBarTitleColor" Value="#F5A623"/>
        </Style>
    </Shell.Resources>

    <TabBar>
        <!-- Tab 0: Bản đồ -->
        <ShellContent
            Title="Bản đồ"
            ContentTemplate="{DataTemplate pages:MainPage}"
            Route="MapPage"
            Shell.PresentationMode="NotAnimated">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MDI"
                    Glyph="&#xF034D;"
                    Size="20"
                    Color="#F5A623"/>
            </ShellContent.Icon>
        </ShellContent>

        <!-- Tab 1: Tour -->
        <ShellContent
            Title="Tour"
            ContentTemplate="{DataTemplate pages:TourPage}"
            Route="TourPage"
            Shell.PresentationMode="NotAnimated">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MDI"
                    Glyph="&#xF02CE;"
                    Size="20"
                    Color="#F5A623"/>
            </ShellContent.Icon>
        </ShellContent>

        <!-- Tab 2: Đã lưu -->
        <ShellContent
            Title="Đã lưu"
            ContentTemplate="{DataTemplate pages:SavedPage}"
            Route="SavedPage"
            Shell.PresentationMode="NotAnimated">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MDI"
                    Glyph="&#xF02D1;"
                    Size="20"
                    Color="#F5A623"/>
            </ShellContent.Icon>
        </ShellContent>

        <!-- Tab 3: Cá nhân -->
        <ShellContent
            Title="Cá nhân"
            ContentTemplate="{DataTemplate pages:ProfilePage}"
            Route="ProfilePage"
            Shell.PresentationMode="NotAnimated">
            <ShellContent.Icon>
                <FontImageSource
                    FontFamily="MDI"
                    Glyph="&#xF0004;"
                    Size="20"
                    Color="#F5A623"/>
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>
</Shell>
